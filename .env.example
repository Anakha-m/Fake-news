# Django Secret Key
SECRET_KEY=django-insecure-sdg-fake-news-detection-system-key-2026-secure

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# News API Configuration (Optional: get a free key from https://newsapi.org or leave blank for DuckDuckGo/Wikipedia fallback)
NEWS_API_KEY=

# GNews API Key (Optional: get a free key from https://gnews.io or leave blank)
GNEWS_API_KEY=

# Google Fact Check Tools API Key (Optional: get a key from Google Cloud Console or leave blank for open search)
GOOGLE_FACT_CHECK_API_KEY=
